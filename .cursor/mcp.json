{
  "mcpServers": {
    "plygon-blender": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}/blender-mcp",
        "plygon-blender-mcp"
      ],
      "env": {
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876"
      }
    },
    "plygon-houdini": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}/houdini-mcp",
        "plygon-houdini-mcp"
      ],
      "env": {
        "HOUDINI_HOST": "127.0.0.1",
        "HOUDINI_PORT": "9877"
      }
    }
  }
}
