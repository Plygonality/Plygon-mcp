{
  "mcpServers": {
    "plygon-houdini": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${workspaceFolder}/houdini-mcp",
        "plygon-houdini-mcp"
      ],
      "env": {
        "HOUDINI_HOST": "localhost",
        "HOUDINI_PORT": "9877"
      }
    }
  }
}
