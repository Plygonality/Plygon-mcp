{
  "mcpServers": {
    "plygon-houdini": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/EmilvanDam/Plygon.git#subdirectory=houdini-mcp",
        "plygon-houdini-mcp"
      ],
      "env": {
        "HOUDINI_HOST": "localhost",
        "HOUDINI_PORT": "9877",
        "PYTHONUTF8": "1"
      }
    }
  }
}
